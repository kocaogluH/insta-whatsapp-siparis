# ==============================================================================
# InstaSipariş Platformu - Ortam Değişkenleri Şablonu (.env.example)
# ==============================================================================

# 1. Veritabanı Bağlantı Dizesi (Neon PostgreSQL)
# Neon Console -> Dashboard -> Connection String (SSL mode = require)
DATABASE_URL="postgresql://kullanici:sifre@ep-xyz.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# 2. JWT Oturum İmzalama Gizli Anahtarı (En az 32 karakter)
# Terminalde üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# 3. Süper Admin Giriş Şifresi
ADMIN_PASSWORD=""

# 4. Upstash Redis (Serverless Brute-Force Koruması ve Hız Sınırları)
# Upstash Console -> Redis Database -> REST API Details
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# 5. Vercel Blob (Ürün Fotoğrafı Depolama)
# Vercel Dashboard -> Storage -> Blob oluşturulduğunda otomatik eklenir
BLOB_READ_WRITE_TOKEN=""
